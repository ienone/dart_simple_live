#!/usr/bin/env python3
"""Seal real-run artifacts without copying private profile contents."""
import hashlib
import json
import os
import re
from pathlib import Path
import subprocess
import sys
from datetime import datetime, timezone
from urllib.parse import urlsplit, urlunsplit

artifact = Path(os.environ['SLIVE_E2E_ARTIFACT_DIR'])
repo = Path(os.environ['SLIVE_E2E_REPO'])
manifest_path = artifact / 'manifest.json'


def stamp():
    return datetime.now(timezone.utc).isoformat()


def git(*args):
    return subprocess.check_output(['git', '-C', str(repo), *args])


def sha(data):
    return hashlib.sha256(data).hexdigest()


def source():
    tracked_diff = git('diff', '--binary', 'HEAD')
    untracked = {}
    for name in git('ls-files', '--others', '--exclude-standard', '-z').decode().split('\0'):
        if name and (repo / name).is_file():
            untracked[name] = sha((repo / name).read_bytes())
    return {'revision': git('rev-parse', 'HEAD').decode().strip(),
            'tracked_diff_sha256': sha(tracked_diff), 'untracked_source_sha256': untracked}


def save_patch():
    patch = bytearray(git('diff', '--binary', 'HEAD'))
    for name in git('ls-files', '--others', '--exclude-standard', '-z').decode().split('\0'):
        if name and (repo / name).is_file():
            result = subprocess.run(['git', 'diff', '--no-index', '--binary', '--', '/dev/null', name],
                                    cwd=repo, stdout=subprocess.PIPE, check=False)
            if result.returncode not in (0, 1):
                raise RuntimeError('Cannot capture source patch for ' + name)
            patch.extend(result.stdout)
    (artifact / 'source.patch').write_bytes(patch)


def scenarios():
    result = []
    for path in sorted(artifact.glob('scenarios-*.json')):
        result.extend(json.loads(path.read_text()))
    return result


def sanitize_logs():
    """Keep native diagnostic evidence, discard ephemeral credentials."""
    counts = {'header_lines': 0, 'url_queries': 0}
    def clean_url(match):
        value = match.group(0)
        parsed = urlsplit(value)
        if parsed.query or parsed.fragment:
            counts['url_queries'] += 1
            return urlunsplit((parsed.scheme, parsed.netloc, parsed.path, 'REDACTED', ''))
        return value
    def clean_text(text):
        return re.sub(r'https?://[^\s<>"\x1b]+', clean_url, text)
    for path in artifact.glob('*.log'):
        text = path.read_text(errors='replace')
        lines = []
        for line in text.splitlines(keepends=True):
            if re.search(r'\b(cookie|authorization|set-cookie)\b\s*[:=：]', line, re.I):
                counts['header_lines'] += 1
                lines.append('[credential-bearing log line redacted]\n')
            else:
                lines.append(line)
        text = clean_text(''.join(lines))
        path.write_text(text)
    def clean_value(value):
        if isinstance(value, str):
            return clean_text(value)
        if isinstance(value, list):
            return [clean_value(item) for item in value]
        if isinstance(value, dict):
            return {key: clean_value(item) for key, item in value.items()}
        return value
    for path in artifact.glob('*.json'):
        if path != manifest_path:
            path.write_text(json.dumps(clean_value(json.loads(path.read_text())),
                                       indent=2, ensure_ascii=False) + '\n')
    return counts


mode = sys.argv[1]
if mode == 'begin':
    save_patch()
    manifest_path.write_text(json.dumps({'schema': 1, 'started_utc': stamp(),
        'command': os.environ['SLIVE_E2E_COMMAND'], 'source_before': source(),
        'selected_phases': os.environ['SLIVE_E2E_PHASES'].split(),
        'profile': 'isolated real XDG profile; private contents excluded',
        'transport': 'real HTTPS via configured proxy; TLS verified; localhost bypass'}, indent=2) + '\n')
elif mode == 'finish':
    manifest = json.loads(manifest_path.read_text())
    manifest['log_redactions'] = sanitize_logs()
    observed = scenarios()
    if not observed and int(sys.argv[2]) != 0:
        observed = [{'scenario': 'application-startup-or-runner', 'status': 'failed',
                     'reason': 'The real process stopped before scenario reporting. Inspect flutter-exercise.log and native logs.'}]
    manifest.update({'finished_utc': stamp(), 'exit_code': int(sys.argv[2]),
                     'source_after': source(), 'scenarios': observed})
    manifest['unexecuted_phases'] = [phase for phase in
        manifest['selected_phases']
        if not any(s.get('phase') == phase for s in observed)]
    manifest['source_changed_during_run'] = manifest['source_before'] != manifest['source_after']
    manifest['artifacts'] = {str(p.relative_to(artifact)): {'bytes': p.stat().st_size, 'sha256': sha(p.read_bytes())}
        for p in sorted(artifact.rglob('*')) if p.is_file() and p != manifest_path
        and not {'profile', 'peer-profile'}.intersection(p.relative_to(artifact).parts)}
    manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + '\n')
elif mode == 'clean':
    sanitize_logs()
elif mode == 'status':
    results = scenarios()
    if not results or any(s['status'] == 'failed' for s in results):
        sys.exit(1)
    if any(s['status'] == 'blocked' for s in results):
        sys.exit(2)
elif mode == 'progress':
    path = artifact / ('scenarios-' + sys.argv[2] + '.json')
    if path.exists() and path.stat().st_size:
        for scenario in json.loads(path.read_text()):
            print(scenario['phase'] + ': ' + scenario['scenario'] + ' — ' + scenario['status'])
